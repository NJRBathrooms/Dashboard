{
  "version": 2,
  "functions": {
    "api/write.js": { "maxDuration": 60 },
    "api/emp-write.js": { "maxDuration": 60 },
    "api/rentals-write.js": { "maxDuration": 60 },
    "api/rentals-cron.js": { "maxDuration": 60 }
  },
  "rewrites": [
    { "source": "/funcionarios", "destination": "/employees.html" },
    { "source": "/rentals", "destination": "/rentals.html" },
    { "source": "/subcontractors", "destination": "/subcontractors.html" },
    { "source": "/curso-schluter", "destination": "/curso-schluter.html" }
  ],
  "crons": [
    { "path": "/api/rentals-cron", "schedule": "0 12 * * *" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "no-referrer" }
      ]
    },
    {
      "source": "/",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, must-revalidate" }
      ]
    },
    {
      "source": "/(rentals|funcionarios|subcontractors|curso-schluter)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, must-revalidate" }
      ]
    },
    {
      "source": "/(curso-schluter|curso-schluter\\.html)",
      "headers": [
        { "key": "Content-Security-Policy", "value": "default-src 'none'; script-src 'sha256-RGF1uc8ATr5trS4WQB1tNXfuy4/9oQN0OASX+/5WPUA='; style-src 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self'; connect-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'" },
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=()" }
      ]
    },
    {
      "source": "/(.*)\\.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, must-revalidate" }
      ]
    },
    {
      "source": "/manifest-rentals.json",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, must-revalidate" }
      ]
    }
  ]
}
