{
  "version": 2,
  "functions": {
    "api/write.js": { "maxDuration": 60 },
    "api/emp-write.js": { "maxDuration": 60 },
    "api/rentals-write.js": { "maxDuration": 60 }
  },
  "rewrites": [
    { "source": "/funcionarios", "destination": "/employees.html" },
    { "source": "/rentals", "destination": "/rentals.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "no-referrer" }
      ]
    }
  ]
}
